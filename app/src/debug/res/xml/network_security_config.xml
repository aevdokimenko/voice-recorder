<?xml version="1.0" encoding="utf-8"?>
<!--
Debug source set only — never part of a release build.

Permits cleartext to the emulator's host loopback alias so a local test receiver can be used
while developing the upload feature. Everything else, including the real endpoint, still
requires TLS.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
