# Copy to .env and edit. Never commit .env.

# Hostname clients reach, used by Caddy for HTTPS. For a LAN-only box this can be a public
# DNS name pointing at a private IP (see DEPLOY.md section 8) — the certificate is still real.
LR_DOMAIN=lr.example.com

# Only for a LAN deployment using the DNS-01 challenge (DEPLOY.md section 8, option A).
# Scoped DNS-edit token for your provider. Leave blank on a normal public-domain setup.
CLOUDFLARE_API_TOKEN=

# Comma-separated enrollment tokens that may appear in a QR code.
# Generate with: openssl rand -base64 24 | tr -d '=+/'
LR_ENROLLMENT_TOKENS=replace-me

# Networks allowed to enroll with NO token, for the app's well-known probe.
# Leave blank to require a QR scan for every device.
LR_TRUSTED_NETWORKS=

# Recording settings pushed to devices. codec is "aac" (.m4a) or "opus" (.ogg).
LR_CODEC=aac
LR_BITRATE=96000
LR_SAMPLE_RATE=44100
LR_DAYS_UNTIL_TRASH=15
LR_DAYS_UNTIL_PURGE=30

# Object storage. Change these before exposing anything.
MINIO_ROOT_USER=lr-admin
MINIO_ROOT_PASSWORD=change-me-long-random
LR_S3_BUCKET=recordings
